# Database & Persistence
POSTGRES_USER=sre
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=multimodal_sre
DATABASE_URL=postgresql+asyncpg://sre:replace_with_secure_postgres_password@postgres:5432/multimodal_sre

# Redis & Celery
REDIS_URL=redis://redis:6379/0

# Qdrant Vector Database
QDRANT_URL=http://qdrant:6333

# Prometheus
PROMETHEUS_URL=http://prometheus:9090

# Authentication & Security
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Investigation Provider (deterministic | ollama | openai)
MODEL_PROVIDER=deterministic
MODEL_NAME=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_API_KEY=

# SRE Operations & Remediation
EXECUTION_MODE=simulation
ANOMALY_THRESHOLD=0.65
MAX_INVESTIGATION_LOOPS=3
LOG_LEVEL=INFO

# Observability
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
NEXT_PUBLIC_API_URL=http://localhost:8000
